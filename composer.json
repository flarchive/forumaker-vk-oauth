{
  "name": "forumaker/vk-oauth",
  "description": "Adds a VK ID OAuth provider for FoF OAuth",
  "type": "flarum-extension",
  "keywords": ["flarum", "flarum-extension", "vk", "vkontakte", "vkid", "oauth"],
  "license": "MIT",
  "homepage": "https://github.com/forumaker/VK-Oauth",
  "support": {
    "issues": "https://github.com/forumaker/VK-Oauth/issues",
    "source": "https://github.com/forumaker/VK-Oauth",
    "forum": "https://discuss.flarum.org/"
  },
  "authors": [
    {
      "name": "forumaker",
      "role": "Developer",
      "homepage": "https://github.com/forumaker"
    }
  ],
  "require": {
    "php": "^8.2",
    "flarum/core": "^2.0",
    "fof/oauth": "^2.0",
    "league/oauth2-client": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "forumaker\\Vk\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2.x": "2.x-dev"
    },
    "flarum-extension": {
      "title": "VK OAuth",
      "category": "authentication",
      "icon": {
        "name": "fa-brands fa-vk",
        "backgroundColor": "#0077FF",
        "color": "#ffffff"
      }
    }
  },
  "config": {
    "sort-packages": true
  }
}
