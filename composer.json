{
  "name": "forumaker/vk-oauth",
  "description": "Adds a VK ID OAuth provider for FoF OAuth",
  "type": "flarum-extension",
  "keywords": [
    "flarum",
    "flarum-extension",
    "vk",
    "vkontakte",
    "vkid",
    "oauth"
  ],
  "license": "MIT",
  "homepage": "https://github.com/forumaker/VK-Oauth",
  "support": {
    "issues": "https://github.com/forumaker/VK-Oauth/issues",
    "source": "https://github.com/forumaker/VK-Oauth",
    "forum": "https://discuss.flarum.org/d/39702-vk-oauth-vk-id-for-fof-oauth"
  },
  "authors": [
    {
      "name": "forumaker",
      "role": "Developer",
      "email": "arsenygpt@gmail.com",
      "homepage": "https://github.com/forumaker"
    }
  ],
  "require": {
    "php": "^8.3",
    "flarum/core": "^2.0.0",
    "fof/oauth": "^2.0",
    "league/oauth2-client": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "forumaker\\Vk\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2.x": "2.x-dev"
    },
    "flarum-extension": {
      "title": "VK OAuth",
      "category": "authentication",
      "icon": {
        "name": "fa-brands fa-vk",
        "backgroundColor": "#0077FF",
        "color": "#ffffff"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "flarum/testing": "^2.0.0"
  },
  "autoload-dev": {
    "psr-4": {
      "forumaker\\Vk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@test:unit"
    ],
    "test:unit": "phpunit -c tests/phpunit.unit.xml"
  }
}
